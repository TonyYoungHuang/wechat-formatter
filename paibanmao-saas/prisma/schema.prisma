generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PlanCode {
  free
  starter
  pro
}

enum AccountProfileType {
  wechat_official
  green_note
  question_host
  personal_ip
  local_business
}

enum TopicStatus {
  idea
  generated
  editing
  ready
  published
  reviewed
}

enum ContentGoal {
  growth
  search
  conversion
  trust
  interaction
}

enum ContentEntry {
  wechat_article
  green_note
  search
  question
  moments
}

enum GenerationStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  expired
  refunded
}

enum InvoiceStatus {
  requested
  issued
  rejected
  cancelled
}

enum AuthTokenPurpose {
  email_verification
  password_reset
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  emailVerifiedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]
  authTokens   AuthToken[]
  loginAttempts LoginAttempt[]
  activationCodeRedemptions ActivationCodeRedemption[]
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, expiresAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  email     String
  ipAddress String
  userAgent String?
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@index([success, createdAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  planCode  PlanCode @default(free)
  riskStatus String  @default("normal")
  riskNote   String?
  riskFlaggedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          WorkspaceMember[]
  accountProfiles  AccountProfile[]
  topics           Topic[]
  projects         ContentProject[]
  calendarItems    ContentCalendarItem[]
  usageLogs        UsageLog[]
  subscriptions    Subscription[]
  paymentOrders    PaymentOrder[]
  paymentCallbacks PaymentCallback[]
  invoices         InvoiceRequest[]
  ctaSnippets      CtaSnippet[]
  contentTemplates ContentTemplate[]
  activationCodeRedemptions ActivationCodeRedemption[]
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        String   @default("owner")
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

model PricingPlan {
  id          String   @id @default(cuid())
  code        PlanCode @unique
  name        String
  description String
  priceCents  Int?
  currency    String   @default("CNY")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entitlements PlanEntitlement[]
  versions     PricingVersion[]
}

model PricingVersion {
  id        String   @id @default(cuid())
  planCode  PlanCode
  version   Int
  snapshot  Json
  note      String?
  createdAt DateTime @default(now())

  plan PricingPlan @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@unique([planCode, version])
  @@index([createdAt])
}

model PlanEntitlement {
  id        String   @id @default(cuid())
  planCode  PlanCode
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan PricingPlan @relation(fields: [planCode], references: [code], onDelete: Cascade)

  @@unique([planCode, key])
}

model Subscription {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  planCode    PlanCode
  status      String    @default("active")
  startsAt    DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ActivationCode {
  id              String    @id @default(cuid())
  codeHash        String    @unique
  codePrefix      String
  codeSuffix      String
  planCode        PlanCode
  status          String    @default("active")
  maxRedemptions  Int       @default(1)
  redeemedCount   Int       @default(0)
  durationDays    Int?
  batchName       String?
  source          String?   @default("ecommerce")
  note            String?
  expiresAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  redemptions ActivationCodeRedemption[]

  @@index([planCode, status])
  @@index([createdAt])
  @@index([expiresAt])
}

model ActivationCodeRedemption {
  id                    String   @id @default(cuid())
  activationCodeId      String
  workspaceId           String
  userId                String
  planCode              PlanCode
  beforePlanCode        PlanCode
  subscriptionExpiresAt DateTime?
  redeemedAt            DateTime @default(now())

  activationCode ActivationCode @relation(fields: [activationCodeId], references: [id], onDelete: Cascade)
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activationCodeId, workspaceId])
  @@index([workspaceId, redeemedAt])
  @@index([userId, redeemedAt])
}

model AccountProfile {
  id                  String             @id @default(cuid())
  workspaceId         String
  name                String
  type                AccountProfileType
  niche               String
  persona             String
  audience            String
  audiencePainPoints  String
  productOrService    String
  monetizationMethods String[]
  tone                String
  commonCta           String
  forbiddenWords      String[]
  sampleText          String?
  isDefault           Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  workspace     Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  topics        Topic[]
  projects      ContentProject[]
  calendarItems ContentCalendarItem[]
  ctaSnippets   CtaSnippet[]
  contentTemplates ContentTemplate[]
}

model Topic {
  id               String         @id @default(cuid())
  workspaceId      String
  accountProfileId String
  title            String
  reason           String
  goals            ContentGoal[]
  entries          ContentEntry[]
  status           TopicStatus    @default(idea)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountProfile AccountProfile        @relation(fields: [accountProfileId], references: [id], onDelete: Cascade)
  projects       ContentProject[]
  calendarItems  ContentCalendarItem[]
}

model ContentProject {
  id               String      @id @default(cuid())
  workspaceId      String
  accountProfileId String
  topicId          String?
  title            String
  status           TopicStatus @default(generated)
  publishedAt      DateTime?
  reviewNote       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountProfile AccountProfile        @relation(fields: [accountProfileId], references: [id], onDelete: Cascade)
  topic          Topic?                @relation(fields: [topicId], references: [id], onDelete: SetNull)
  variants       ContentVariant[]
  reports        ComplianceReport[]
  calendarItems  ContentCalendarItem[]
  metrics        ContentMetric[]
}

model ContentCalendarItem {
  id               String       @id @default(cuid())
  workspaceId      String
  accountProfileId String?
  topicId          String?
  projectId        String?
  entry            ContentEntry
  title            String
  status           TopicStatus  @default(ready)
  scheduledFor     DateTime
  publishedAt      DateTime?
  note             String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountProfile AccountProfile? @relation(fields: [accountProfileId], references: [id], onDelete: SetNull)
  topic          Topic?          @relation(fields: [topicId], references: [id], onDelete: SetNull)
  project        ContentProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([workspaceId, scheduledFor])
  @@index([workspaceId, status])
  @@index([workspaceId, entry])
}

model ContentVariant {
  id        String       @id @default(cuid())
  projectId String
  entry     ContentEntry
  title     String
  body      String
  metadata  Json?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  project ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, entry])
}

model ContentMetric {
  id                String        @id @default(cuid())
  projectId         String
  entry             ContentEntry?
  readCount         Int           @default(0)
  likeCount         Int           @default(0)
  watchCount        Int           @default(0)
  favoriteCount     Int           @default(0)
  commentCount      Int           @default(0)
  followerGain      Int           @default(0)
  consultationCount Int           @default(0)
  dealCount         Int           @default(0)
  note              String?
  recordedAt        DateTime      @default(now())
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project ContentProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, recordedAt])
  @@index([entry])
}

model CtaSnippet {
  id               String        @id @default(cuid())
  workspaceId      String
  accountProfileId String?
  title            String
  category         String
  entry            ContentEntry?
  content          String
  tags             String[]
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountProfile AccountProfile? @relation(fields: [accountProfileId], references: [id], onDelete: SetNull)

  @@index([workspaceId, active])
  @@index([accountProfileId])
  @@index([entry])
}

model ContentTemplate {
  id               String        @id @default(cuid())
  workspaceId      String
  accountProfileId String?
  title            String
  category         String
  entry            ContentEntry?
  content          String
  tags             String[]
  active           Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountProfile AccountProfile? @relation(fields: [accountProfileId], references: [id], onDelete: SetNull)

  @@index([workspaceId, active])
  @@index([accountProfileId])
  @@index([entry])
}

model AiProvider {
  id        String   @id @default(cuid())
  name      String   @unique
  type      String   @default("openai-compatible")
  baseUrl   String
  apiKeyRef String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models AiModel[]
}

model AiModel {
  id         String   @id @default(cuid())
  providerId String
  name       String
  modelId    String
  purpose    String   @default("content")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

model PromptTemplate {
  id        String   @id @default(cuid())
  key       String
  version   Int
  content   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs GenerationJob[]

  @@unique([key, version])
}

model GenerationJob {
  id               String           @id @default(cuid())
  workspaceId      String
  accountProfileId String?
  promptTemplateId String?
  type             String
  status           GenerationStatus @default(pending)
  input            Json
  output           Json?
  error            String?
  tokenInput       Int              @default(0)
  tokenOutput      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  promptTemplate PromptTemplate? @relation(fields: [promptTemplateId], references: [id], onDelete: SetNull)
}

model ComplianceReport {
  id        String   @id @default(cuid())
  projectId String
  score     Int
  level     String
  summary   String
  createdAt DateTime @default(now())

  project ContentProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  ComplianceIssue[]
}

model ComplianceIssue {
  id         String   @id @default(cuid())
  reportId   String
  category   String
  severity   String
  excerpt    String
  message    String
  suggestion String
  createdAt  DateTime @default(now())

  report ComplianceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id          String   @id @default(cuid())
  workspaceId String
  key         String
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model PaymentOrder {
  id              String        @id @default(cuid())
  workspaceId     String
  planCode        PlanCode
  provider        String
  amountCents     Int
  currency        String        @default("CNY")
  status          PaymentStatus @default(pending)
  providerOrderId String?
  providerTradeNo String?
  checkout        Json?
  paidAt          DateTime?
  expiresAt       DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  callbacks PaymentCallback[]
  invoices  InvoiceRequest[]
}

model InvoiceRequest {
  id             String        @id @default(cuid())
  workspaceId    String
  paymentOrderId String
  title          String
  taxNumber      String?
  email          String
  amountCents    Int
  status         InvoiceStatus @default(requested)
  note           String?
  issuedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([paymentOrderId])
  @@index([status])
}

model PaymentCallback {
  id              String   @id @default(cuid())
  workspaceId     String?
  paymentOrderId  String?
  provider        String
  status          String
  eventType       String?
  providerTradeNo String?
  rawBody         String
  payload         Json?
  signature       String?
  message         String?
  createdAt       DateTime @default(now())

  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id], onDelete: SetNull)

  @@index([provider, status, createdAt])
  @@index([workspaceId, createdAt])
  @@index([paymentOrderId, createdAt])
}
